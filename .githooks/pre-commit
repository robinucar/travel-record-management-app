#!/bin/sh

echo "Running Ruff checks..."
python -m ruff check .

if [ $? -ne 0 ]; then
  echo ""
  echo "Commit stopped because Ruff checks failed."
  echo "Please fix the issues and try again."
  exit 1
fi

echo ""
echo "Running tests..."
python -m pytest
pytest_exit_code=$?

if [ $pytest_exit_code -eq 5 ]; then
  echo ""
  echo "No tests found yet. Continuing because the project is in setup stage."
elif [ $pytest_exit_code -ne 0 ]; then
  echo ""
  echo "Commit stopped because tests failed."
  echo "Please fix the tests and try again."
  exit 1
fi

echo ""
echo "All pre-commit checks passed."
